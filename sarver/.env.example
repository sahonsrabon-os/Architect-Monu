# =============================================================================
# Mission Barisal v3 — Environment Variable Reference (.env.example)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
# Every variable below is either verified in code (start.js / api.js / bridge.js)
# or part of the documented fix plan (sarver/doc/APPLY-FIXES.md).
# =============================================================================

# ---- Server core ------------------------------------------------------------
PORT=5000                        # Engine port (bridge forwards 9999 -> 5000)
LOG_DIR=./logs                   # Log directory (api.js reads this)
DATA_DIR=./data                  # Data directory (sessions, clients, locks)

# ---- MCP allowed directories (FIX Issue #1 - temp-file/access-denied bug) ---
# Default (no env): only logs, data, and cwd are allowed -> VS Code writes big
# MCP results to its workspaceStorage, read_file denies that path.
# Fix: add the client's workspaceStorage parent (the hash folder changes):
ALLOWED_DIRS=./logs,./data,.,C:\Users\sahon\AppData\Roaming\Code\User\workspaceStorage

# ---- Living Team Environment (banter layer) ---------------------------------
LIVING_TEAM=1                    # 1 = playful status/banter lines, 0 = off

# ---- Agent tool rounds (FIX Issue #3 - missions die early) ------------------
# Current default is 5 (too low). Raise to 12-20:
MAX_TOOL_ROUNDS=20

# ---- Bridge (Caddy replacement, bridge.js) ----------------------------------
BRIDGE_LISTEN_HOST=127.0.0.1     # bridge listen host
BRIDGE_PORT=9999                 # bridge listen port (editors connect here)
BRIDGE_TARGET_HOST=127.0.0.1     # upstream engine host
BRIDGE_TARGET_PORT=5000          # upstream engine port

# ---- Custom AI providers (priority-based fallback chain) --------------------
# Numbered providers; lower PRIORITY number = tried first.
# TYPE: openai-compatible | anthropic | custom
# CUSTOM_PROVIDER_1_NAME=opencode
# CUSTOM_PROVIDER_1_URL=https://...
# CUSTOM_PROVIDER_1_KEY=sk-...
# CUSTOM_PROVIDER_1_MODELS=model-a,model-b
# CUSTOM_PROVIDER_1_PRIORITY=1
# CUSTOM_PROVIDER_1_TYPE=openai-compatible

# CUSTOM_PROVIDER_2_NAME=custom_1
# CUSTOM_PROVIDER_2_URL=https://...
# CUSTOM_PROVIDER_2_KEY=...
# CUSTOM_PROVIDER_2_MODELS=...
# CUSTOM_PROVIDER_2_PRIORITY=2
# CUSTOM_PROVIDER_2_TYPE=openai-compatible

# ---- External tool connector (ENV-DRIVEN, NEW 2026-08-07) -------------------
# Attach external tools WITHOUT code changes. Numbered like CUSTOM_PROVIDER_N_*.
# The connector registers these into MCP_TOOLS at startup and proxies tool calls
# to the external URL as JSON { tool, arguments }.
# EXTERNAL_TOOL_1_NAME=git_commit
# EXTERNAL_TOOL_1_URL=http://localhost:7001/tools/git_commit
# EXTERNAL_TOOL_1_KEY=optional-secret      # sent as Authorization: Bearer <KEY>
# EXTERNAL_TOOL_1_METHOD=POST              # default POST
# EXTERNAL_TOOL_1_DESCRIPTION=Create a git commit
# EXTERNAL_TOOL_1_PARAMS={"repo":{"type":"string"},"message":{"type":"string"}}

# ---- Provider health (FIX Issue #2 - HTTP 302 fallback storm) ---------------
# 302/401/403 = permanent config error -> fix the URL, not the code.
# Planned (not yet in code): health probe interval, circuit-breaker thresholds.

# ---- Audio / TTS (optional, used by sarver/audio/analyze_audio.py) ----------
# EDGE_TTS_VOICE=bn-BD-PradeepNeural   # Bangladeshi Bengali male neural voice
# EDGE_TTS_RATE=+0%
